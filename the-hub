local function MakeButton(text, order)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 180, 0, 40) -- wider
	btn.Position = UDim2.new(0, 10 + (order % 2) * 190, 0, 50 + math.floor(order/2) * 50)
	btn.BackgroundColor3 = Color3.fromRGB(50, 110, 255)
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Font = Enum.Font.GothamBold
	btn.TextScaled = true
	btn.BorderSizePixel = 0
	btn.Text = text
	btn.Parent = Frame
	return btn
end

